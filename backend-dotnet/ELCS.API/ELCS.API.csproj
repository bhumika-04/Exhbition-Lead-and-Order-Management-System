<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQL Server + Dapper -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />

    <!-- Image Processing -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- OpenAI -->
    <PackageReference Include="OpenAI" Version="2.8.0" />

    <!-- Utilities -->
    <!-- 10.2.3+ : 10.1.0 pulled Microsoft.OpenApi 2.3.0, which carries
         GHSA-v5pm-xwqc-g5wc (high). Bumped here rather than pinning
         Microsoft.OpenApi directly, so we do not take a direct reference on a
         package we never call and then have to remember to keep it in step. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
