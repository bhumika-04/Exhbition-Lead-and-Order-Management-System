# Backend API base URL.
#
# Local development: leave this file alone and use .env.local. api.ts falls back
# to the current hostname on port 5008 when the value is localhost, which is what
# lets a phone on the booth Wi-Fi reach the dev machine without configuration.
#
# Vercel: set NEXT_PUBLIC_API_BASE_URL in the project's Environment Variables,
# NOT in a committed file — it must be present at BUILD time because NEXT_PUBLIC_
# values are inlined into the bundle, so changing it needs a redeploy.
#
# No trailing slash: the client appends paths beginning with "/api/...".
NEXT_PUBLIC_API_BASE_URL=https://tejooeloms.indusanalytics.co.in
